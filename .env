API_TOKEN="your_api_token"
OPEN_AI_API_KEY="your open ai api key"
OPEN_AI_BASE_URL="https://api.moonshot.cn/v1" # for moonshot demo

# LLM 提供商切换（可选值：moonshot / openai / minimax）
# LLM_PROVIDER="minimax"

# MiniMax 配置（设置 MINIMAX_API_KEY 后自动启用 MiniMax）
# MINIMAX_API_KEY="your minimax api key"
# LLM_MODEL="MiniMax-M2.7"  # 可选：MiniMax-M2.7, MiniMax-M2.7-highspeed